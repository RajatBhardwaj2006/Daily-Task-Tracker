{
  "name": "daily-task-tracker",
  "version": "1.0.0",
  "description": "Offline daily must/optional task tracker for Windows",
  "main": "src/main.js",
  "author": "Cherry",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.cherry.dailytasktracker",
    "productName": "Daily Task Tracker",
    "artifactName": "Daily-Task-Tracker-${version}-Setup.exe",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Daily Task Tracker"
    }
  }
}
